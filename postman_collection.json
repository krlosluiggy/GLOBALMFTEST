				{
					"name": "Delete User",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users/{{userId}}",
							"host": ["{{baseUrl}}"],
							"path": ["users", "{{userId}}"]
						},
						"description": "Elimina un usuario del sistema."
					},
					"response": []
				}
			],
			"description": "CRUD completo de usuarios"
		},
		{
			"name": "GraphQL",
			"item": [
				{
					"name": "Query Programs",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"query\": \"query GetPrograms($filter: FilterProgramInput, $page: Int) { programs(filter: $filter, page: $page) { items { id name description start_date status created_at updated_at } total } }\",\n    \"variables\": {\n        \"filter\": {\n            \"status\": \"active\"\n        },\n        \"page\": 1\n    }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/graphql",
							"host": ["{{baseUrl}}"],
							"path": ["graphql"]
						},
						"description": "Query GraphQL para obtener programas con filtros."
					},
					"response": []
				},
				{
					"name": "Query All Programs (Simple)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"query\": \"{ programs(page: 1) { items { id name status } total } }\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/graphql",
							"host": ["{{baseUrl}}"],
							"path": ["graphql"]
						},
						"description": "Query GraphQL simple para obtener todos los programas."
					},
					"response": []
				}
			],
			"description": "Endpoints GraphQL"
		}
	],
